{
  "format": "filter-fab-js",
  "version": 2,
  "id": "photoshop-style-threshold",
  "tags": [
    "Monochrome",
    "Tone",
    "Utility"
  ],
  "mathMode": "float",
  "name": "Photoshop-Style Threshold",
  "description": "Photoshop Threshold-inspired binary luminance conversion. Each pixel becomes exactly black or white according to one Threshold Level (1–255; default 128). Higher levels produce more black and lower levels more white. The input RGB channels are compared using the engine's weighted luminance i=(299R+587G+114B)/1000. Source transparency is preserved. No anti-aliasing, dithering, blur, or color is introduced. Photoshop color-profile-dependent grayscale processing may produce small differences near the cutoff.",
  "author": "ChromaMeld",
  "formulas": [
    "step(round(val(0,1,255)),i)*255",
    "step(round(val(0,1,255)),i)*255",
    "step(round(val(0,1,255)),i)*255",
    "a"
  ],
  "controls": [
