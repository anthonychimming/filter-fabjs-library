    "lerp(c,clamp(srcLinear(X/2+cx*X/2*(1+(ctl(0)/255)*0.07*(sqr(cx*X/min(X,Y))+sqr(cy*Y/min(X,Y)))),Y/2+cy*Y/2*(1+(ctl(0)/255)*0.07*(sqr(cx*X/min(X,Y))+sqr(cy*Y/min(X,Y)))),z)*(val(3,60,160)/100)*(1-(ctl(1)/255)*0.34*(1-smoothstep(max(2,Y/360)*0.06,max(2,Y/360)*0.28,min(repeat(y,max(2,Y/360)),max(2,Y/360)-repeat(y,max(2,Y/360))))))*(1-sqr(ctl(2)/255)*0.35*smoothstep(max(3,X/420)*0.08,max(3,X/420)*0.30,min(abs(repeat(x,max(3,X/420))-z*max(3,X/420)/3),max(3,X/420)-abs(repeat(x,max(3,X/420))-z*max(3,X/420)/3))))*(1-(ctl(4)/255)*0.45*smoothstep(0.72,1.30,sqrt(sqr(cx)+sqr(cy))))*lerp(1,(1-smoothstep(1.55,2.25,(sqr(sqr(cx*(1+(ctl(0)/255)*0.07*(sqr(cx*X/min(X,Y))+sqr(cy*Y/min(X,Y))))))+sqr(sqr(cy*(1+(ctl(0)/255)*0.07*(sqr(cx*X/min(X,Y))+sqr(cy*Y/min(X,Y))))))))),ctl(0)/255),0,255),ctl(5))",
