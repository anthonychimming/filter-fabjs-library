  "mathMode": "float",
  "name": "Photoshop-Style Emboss",
  "description": "Photoshop-style Emboss approximation with Angle, Height, and Amount controls. The filter compares two source copies separated by the requested Height along the selected Angle, centers their per-channel difference around 50% gray, and scales edge contrast with Amount. This produces neutral gray flat regions with colored highlight and shadow edges, matching the characteristic Photoshop Emboss look. Angle ranges from -360° to +360°, Height from 1 to 100 pixels, and Amount from 1% to 500%. Defaults are 135°, 3 px, and 100%. Source alpha is preserved. Exact Photoshop sampling, rounding, and edge handling are proprietary, so this is a high-fidelity single-pass approximation rather than a bit-exact clone.",
  "author": "ChromaMeld",
  "formulas": [
    "clamp(128+(srcLinear(x+r2x(-val(0,-1024,1024),val(1,1,100)/2),y+r2y(-val(0,-1024,1024),val(1,1,100)/2),z)-srcLinear(x-r2x(-val(0,-1024,1024),val(1,1,100)/2),y-r2y(-val(0,-1024,1024),val(1,1,100)/2),z))*val(2,1,500)/100,0,255)",
    "clamp(128+(srcLinear(x+r2x(-val(0,-1024,1024),val(1,1,100)/2),y+r2y(-val(0,-1024,1024),val(1,1,100)/2),z)-srcLinear(x-r2x(-val(0,-1024,1024),val(1,1,100)/2),y-r2y(-val(0,-1024,1024),val(1,1,100)/2),z))*val(2,1,500)/100,0,255)",
    "clamp(128+(srcLinear(x+r2x(-val(0,-1024,1024),val(1,1,100)/2),y+r2y(-val(0,-1024,1024),val(1,1,100)/2),z)-srcLinear(x-r2x(-val(0,-1024,1024),val(1,1,100)/2),y-r2y(-val(0,-1024,1024),val(1,1,100)/2),z))*val(2,1,500)/100,0,255)",
    "a"
  ],
