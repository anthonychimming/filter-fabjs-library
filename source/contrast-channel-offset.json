    "lerp(c,(ctl(6)<42.5?c:(ctl(6)>212.5?0:abs((ctl(6)<127.5?0:255)-srcLinear(x+r2x(val(4,0,360)*1024/360+256,val(3,0,64)),y+r2y(val(4,0,360)*1024/360+256,val(3,0,64)),1)))),clamp(smoothstep(ctl(0),ctl(0)+max(0.01,val(1,0,100)),max(max(abs(c-src(x+val(2,1,12),y,z)),abs(c-src(x-val(2,1,12),y,z))),max(abs(c-src(x,y+val(2,1,12),z)),abs(c-src(x,y-val(2,1,12),z)))))*clamp(1+(i-127.5)*val(8,-100,100)/12750,0,2),0,1)*ctl(9)/255)",
    "lerp(c,(ctl(7)<42.5?c:(ctl(7)>212.5?0:abs((ctl(7)<127.5?0:255)-srcLinear(x+r2x(val(4,0,360)*1024/360+512,val(3,0,64)),y+r2y(val(4,0,360)*1024/360+512,val(3,0,64)),2)))),clamp(smoothstep(ctl(0),ctl(0)+max(0.01,val(1,0,100)),max(max(abs(c-src(x+val(2,1,12),y,z)),abs(c-src(x-val(2,1,12),y,z))),max(abs(c-src(x,y+val(2,1,12),z)),abs(c-src(x,y-val(2,1,12),z)))))*clamp(1+(i-127.5)*val(8,-100,100)/12750,0,2),0,1)*ctl(9)/255)",
