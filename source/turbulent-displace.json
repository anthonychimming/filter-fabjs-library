  "name": "Turbulent Displace",
  "description": "General-purpose organic image warping for liquid distortion, heat haze, damaged print, and marbling. Two deterministic, decorrelated value-noise fields drive bilinear X/Y source displacement. Direction Bias suppresses one axis toward horizontal- or vertical-only motion; Mix blends the warped RGBA result with the original. Sampling clamps at image edges.",
  "author": "Anthony Chimming",
  "formulas": [
    "lerp(c,srcLinear(x+(valueNoise(x,y,val(1,8,256),val(2,0,9999))*2-1)*val(0,0,128)*(1-max(val(3,-100,100)/100,0)),y+(valueNoise(x+173,y-317,val(1,8,256),val(2,0,9999)+4093)*2-1)*val(0,0,128)*(1-max(-val(3,-100,100)/100,0)),z),ctl(4)/255)",
    "lerp(c,srcLinear(x+(valueNoise(x,y,val(1,8,256),val(2,0,9999))*2-1)*val(0,0,128)*(1-max(val(3,-100,100)/100,0)),y+(valueNoise(x+173,y-317,val(1,8,256),val(2,0,9999)+4093)*2-1)*val(0,0,128)*(1-max(-val(3,-100,100)/100,0)),z),ctl(4)/255)",
    "lerp(c,srcLinear(x+(valueNoise(x,y,val(1,8,256),val(2,0,9999))*2-1)*val(0,0,128)*(1-max(val(3,-100,100)/100,0)),y+(valueNoise(x+173,y-317,val(1,8,256),val(2,0,9999)+4093)*2-1)*val(0,0,128)*(1-max(-val(3,-100,100)/100,0)),z),ctl(4)/255)",
    "lerp(c,srcLinear(x+(valueNoise(x,y,val(1,8,256),val(2,0,9999))*2-1)*val(0,0,128)*(1-max(val(3,-100,100)/100,0)),y+(valueNoise(x+173,y-317,val(1,8,256),val(2,0,9999)+4093)*2-1)*val(0,0,128)*(1-max(-val(3,-100,100)/100,0)),z),ctl(4)/255)"
  ],
