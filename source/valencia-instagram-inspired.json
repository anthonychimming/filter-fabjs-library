    "lerp(r,clamp((clamp(clamp((((r*(1-116*ctl(4)/65025)+58*ctl(4)/255))-127.5)*val(1,0.8,1.3)+127.5,0,255)*val(2,0.8,1.3),0,255))*(1-0.607*val(3,0,0.25))+(clamp(clamp((((g*(1-6*ctl(4)/65025)+3*ctl(4)/255))-127.5)*val(1,0.8,1.3)+127.5,0,255)*val(2,0.8,1.3),0,255))*(0.769*val(3,0,0.25))+(clamp(clamp((((b*(1-114*ctl(4)/65025)+57*ctl(4)/255))-127.5)*val(1,0.8,1.3)+127.5,0,255)*val(2,0.8,1.3),0,255))*(0.189*val(3,0,0.25)),0,255),ctl(0))",
    "lerp(g,clamp((clamp(clamp((((r*(1-116*ctl(4)/65025)+58*ctl(4)/255))-127.5)*val(1,0.8,1.3)+127.5,0,255)*val(2,0.8,1.3),0,255))*(0.349*val(3,0,0.25))+(clamp(clamp((((g*(1-6*ctl(4)/65025)+3*ctl(4)/255))-127.5)*val(1,0.8,1.3)+127.5,0,255)*val(2,0.8,1.3),0,255))*(1-0.314*val(3,0,0.25))+(clamp(clamp((((b*(1-114*ctl(4)/65025)+57*ctl(4)/255))-127.5)*val(1,0.8,1.3)+127.5,0,255)*val(2,0.8,1.3),0,255))*(0.168*val(3,0,0.25)),0,255),ctl(0))",
